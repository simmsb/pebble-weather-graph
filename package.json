{
  "name": "pebble-weather-graph",
  "author": "simmsb",
  "version": "1.0.0",
  "keywords": ["pebble-app"],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.0.10",
    "pebble-fctx": "^1.6.1"
  },
  "devDependencies": {
    "pkts": "^0.3.0-beta.1"
  },
  "scripts": {
    "build": "pkts build"
  },
  "pebble": {
    "displayName": "pebble-weather-graph",
    "uuid": "41ff9e37-899b-4211-9056-f353d2d58dd2",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "WEATHER_REQUEST",
      "WEATHER_SEG_UPDATE_IDX",
      "WEATHER_SEG_TEMPERATURE",
      "WEATHER_SEG_SUN_LEVEL",
      "WEATHER_SEG_IS_DAY",
      "WEATHER_HOUR_UPDATE_IDX",
      "WEATHER_HOUR_RAIN_AMOUNT",
      "WEATHER_HOUR_RAIN_CHANCE",
      "WEATHER_HOUR_CLOUD_COVER",
      "WEATHER_DAY_UPDATE_IDX",
      "WEATHER_DAY_TEMP_HIGH",
      "WEATHER_DAY_TEMP_LOW",
      "WEATHER_DAY_NAME",
      "WEATHER_REPORT_START",
      "WEATHER_LOCATION_NAME",
      "WEATHER_CURRENT_TEMP",
      "SETTING_ACCENT_COLOR"
    ],
    "resources": {
      "media": [
        {
          "type": "font",
          "name": "LM_MONO_48",
          "file": "fonts/lm_mono.otf",
          "characterRegex": "[0-9: ]"
        }
      ]
    },
    "capabilities": [
      "location",
      "configurable"
    ]
  }
}
