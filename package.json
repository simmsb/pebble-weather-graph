{
  "name": "pebble-weather-graph",
  "author": "simmsb",
  "version": "1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@rebble/clay": "^1.0.10",
    "pebble-fctx": "^1.6.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.71.0",
    "@bufbuild/protoc-gen-es": "^2.12.0",
    "pkts": "^0.3.0-beta.1"
  },
  "scripts": {
    "build": "pkts build"
  },
  "pebble": {
    "displayName": "Pebble weather graph",
    "uuid": "41ff9e37-899b-4211-9056-f353d2d58dd2",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "WEATHER_REQUEST",
      "WEATHER_UPDATE",
      "SETTING_ACCENT_COLOR"
    ],
    "resources": {
      "media": [
        {
          "type": "font",
          "name": "LM_MONO_48",
          "file": "fonts/lm_mono.otf",
          "characterRegex": "[0-9: ]"
        }
      ]
    },
    "capabilities": [
      "location",
      "configurable"
    ]
  }
}
